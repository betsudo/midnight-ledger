import CompactStandardLibrary;
export ledger round: Counter;
export circuit hashAndIncrement(v: Field): [] {
  const h0 = persistentHash<Field>(v);
  const h1 = persistentHash<Bytes<32>>(h0);
  const h2 = persistentHash<Bytes<32>>(h1);
  const h3 = persistentHash<Bytes<32>>(h2);
  const h4 = persistentHash<Bytes<32>>(h3);
  const h5 = persistentHash<Bytes<32>>(h4);
  const h6 = persistentHash<Bytes<32>>(h5);
  const h7 = persistentHash<Bytes<32>>(h6);
  const h8 = persistentHash<Bytes<32>>(h7);
  const h9 = persistentHash<Bytes<32>>(h8);
  const h10 = persistentHash<Bytes<32>>(h9);
  const h11 = persistentHash<Bytes<32>>(h10);
  const h12 = persistentHash<Bytes<32>>(h11);
  const h13 = persistentHash<Bytes<32>>(h12);
  const h14 = persistentHash<Bytes<32>>(h13);
  const h15 = persistentHash<Bytes<32>>(h14);
  const h16 = persistentHash<Bytes<32>>(h15);
  const h17 = persistentHash<Bytes<32>>(h16);
  const h18 = persistentHash<Bytes<32>>(h17);
  const h19 = persistentHash<Bytes<32>>(h18);
  const h20 = persistentHash<Bytes<32>>(h19);
  const h21 = persistentHash<Bytes<32>>(h20);
  const h22 = persistentHash<Bytes<32>>(h21);
  const h23 = persistentHash<Bytes<32>>(h22);
  const h24 = persistentHash<Bytes<32>>(h23);
  const h25 = persistentHash<Bytes<32>>(h24);
  const h26 = persistentHash<Bytes<32>>(h25);
  const h27 = persistentHash<Bytes<32>>(h26);
  const h28 = persistentHash<Bytes<32>>(h27);
  const h29 = persistentHash<Bytes<32>>(h28);
  const h30 = persistentHash<Bytes<32>>(h29);
  const h31 = persistentHash<Bytes<32>>(h30);
  const h32 = persistentHash<Bytes<32>>(h31);
  const h33 = persistentHash<Bytes<32>>(h32);
  const h34 = persistentHash<Bytes<32>>(h33);
  const h35 = persistentHash<Bytes<32>>(h34);
  const h36 = persistentHash<Bytes<32>>(h35);
  const h37 = persistentHash<Bytes<32>>(h36);
  const h38 = persistentHash<Bytes<32>>(h37);
  const h39 = persistentHash<Bytes<32>>(h38);
  const h40 = persistentHash<Bytes<32>>(h39);
  const h41 = persistentHash<Bytes<32>>(h40);
  const h42 = persistentHash<Bytes<32>>(h41);
  const h43 = persistentHash<Bytes<32>>(h42);
  const h44 = persistentHash<Bytes<32>>(h43);
  const h45 = persistentHash<Bytes<32>>(h44);
  const h46 = persistentHash<Bytes<32>>(h45);
  const h47 = persistentHash<Bytes<32>>(h46);
  const h48 = persistentHash<Bytes<32>>(h47);
  const h49 = persistentHash<Bytes<32>>(h48);
  assert(h49 != default<Bytes<32>>, "nonzero hash");
  round.increment(1);
}
